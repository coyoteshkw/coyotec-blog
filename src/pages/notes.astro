---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Footer from "@/components/Footer.astro";
import Main from "@/components/Main.astro";
import NoteCard from "@/components/NoteCard.astro";
import { getNotes } from "@/utils/notes";
import config from "@/config";

const { frontmatter, notes, allTags } = await getNotes();
const pageTitle = frontmatter.title ?? "Notes";
---

<Layout
  title={`${pageTitle} | ${config.site.title}`}
  description={frontmatter.description}
>
  <Header />

  <Breadcrumb />

  <Main
    pageTitle={pageTitle}
    pageDesc={frontmatter.description}
    class="app-prose"
  >
    <nav
      id="notes-filter"
      aria-label="按标签筛选"
      class="text-muted-foreground mb-6 flex flex-wrap items-center gap-x-3 gap-y-2 text-xs"
      data-pagefind-ignore
    >
      <button
        type="button"
        data-filter-clear
        class="notes-filter-btn no-underline transition-colors hover:text-accent"
      >
        全部
      </button>
      {
        allTags.map(tag => (
          <button
            type="button"
            data-filter={tag.slug}
            aria-pressed="false"
            class="notes-filter-btn no-underline transition-colors hover:text-accent"
          >
            #{tag.name}
            <span class="opacity-60">{tag.count}</span>
          </button>
        ))
      }
    </nav>

    <p
      id="notes-filter-status"
      class="text-muted-foreground mb-4 hidden text-xs"
      aria-live="polite"
    ></p>

    <div id="notes-area" data-pagefind-body>
      {notes.map(note => <NoteCard {note} />)}
    </div>
  </Main>

  <Footer />
</Layout>

<style>
  /* 选中态（筛选按钮属于本页，scoped 正常生效） */
  .notes-filter-btn[aria-pressed="true"] {
    color: var(--color-accent);
    font-weight: 600;
  }

  /* 被筛掉的卡片：卡片来自 NoteCard 组件（其 scoped 属性不同），
     必须用 :global() 才能命中，同时限定在 #notes-area 内避免泄漏 */
  #notes-area :global(.note-card[data-filtered="true"]) {
    display: none;
  }

  /* 卡片之间的虚线分隔：用 border-top 代替 <hr>，
     避免筛选后残留孤立分隔线。首个可见卡片不显示分隔。 */
  #notes-area :global(.note-card) {
    border-top: 1px dashed var(--border);
    padding-top: 1.5rem;
    margin-top: 1.5rem;
  }

  #notes-area :global(.note-card[data-first="true"]) {
    border-top: none;
    padding-top: 0;
    margin-top: 0;
  }
</style>

<script>
  import { setupCodeBlocks } from "@/scripts/codeBlocks";

  /**
   * Notes 标签筛选（方案 C：原生 JS，多选 OR 逻辑）
   * - 点击标签切换选中，可多选；选中多个时显示包含任一标签的笔记
   * - 无选中时显示全部
   * - 同步 URL query（?tag=a,b），便于分享与刷新保留
   * - 用 replaceState 不污染浏览历史
   */
  function setupNotesFilter() {
    const root = document.getElementById("notes-filter");
    const area = document.getElementById("notes-area");
    if (!root || !area) return;

    const buttons = Array.from(
      root.querySelectorAll<HTMLButtonElement>("[data-filter]")
    );
    const clearBtn = root.querySelector<HTMLButtonElement>(
      "[data-filter-clear]"
    );
    const status = document.getElementById("notes-filter-status");
    const cards = Array.from(area.querySelectorAll<HTMLElement>(".note-card"));

    /** 从 URL 读取初始选中标签（仅保留当前页面存在的标签） */
    function readFromUrl(): string[] {
      const raw = new URLSearchParams(location.search).get("tag");
      if (!raw) return [];
      const valid = new Set(buttons.map(b => b.dataset.filter));
      return raw
        .split(",")
        .map(t => t.trim())
        .filter(t => t && valid.has(t));
    }

    const selected = new Set<string>(readFromUrl());

    function syncUrl() {
      const url = new URL(location.href);
      if (selected.size > 0) {
        url.searchParams.set("tag", [...selected].join(","));
      } else {
        url.searchParams.delete("tag");
      }
      history.replaceState(history.state, "", url);
    }

    function apply() {
      // 1. 更新按钮选中态（顶部筛选栏）
      for (const btn of buttons) {
        btn.setAttribute(
          "aria-pressed",
          String(selected.has(btn.dataset.filter!))
        );
      }

      // 卡片内标签也标记选中态，保持视觉一致
      for (const tagBtn of area!.querySelectorAll<HTMLElement>("[data-filter]")) {
        tagBtn.toggleAttribute(
          "data-active",
          selected.has(tagBtn.dataset.filter!)
        );
      }

      // 2. 过滤卡片
      let visible = 0;
      for (const card of cards) {
        const cardTags = (card.dataset.tags ?? "").split(" ").filter(Boolean);
        const show =
          selected.size === 0 || cardTags.some(t => selected.has(t));

        if (show) {
          card.removeAttribute("data-filtered");
          visible++;
        } else {
          card.setAttribute("data-filtered", "true");
        }
      }

      // 3. 标记第一个可见卡片（用于隐藏其顶部分隔线）
      let firstMarked = false;
      for (const card of cards) {
        if (card.getAttribute("data-filtered") === "true") {
          card.removeAttribute("data-first");
          continue;
        }
        if (!firstMarked) {
          card.setAttribute("data-first", "true");
          firstMarked = true;
        } else {
          card.removeAttribute("data-first");
        }
      }

      // 4. 状态提示
      if (status) {
        if (selected.size === 0) {
          status.classList.add("hidden");
          status.textContent = "";
        } else {
          status.classList.remove("hidden");
          status.textContent = `已筛选 ${selected.size} 个标签，显示 ${visible} 条笔记`;
        }
      }
    }

    // 绑定筛选按钮（顶部筛选栏 + 卡片内标签，用事件委托避免重复绑定）
    const handleFilterClick = (e: Event) => {
      const target = (e.target as HTMLElement).closest<HTMLElement>(
        "[data-filter]"
      );
      if (!target) return;
      const tag = target.dataset.filter;
      if (!tag) return;
      if (selected.has(tag)) selected.delete(tag);
      else selected.add(tag);
      syncUrl();
      apply();
    };

    if (!root.dataset.bound) {
      root.dataset.bound = "true";
      root.addEventListener("click", handleFilterClick);
    }
    if (!area.dataset.bound) {
      area.dataset.bound = "true";
      area.addEventListener("click", handleFilterClick);
    }

    // 清除筛选
    if (!clearBtn?.dataset.bound) {
      if (clearBtn) clearBtn.dataset.bound = "true";
      clearBtn?.addEventListener("click", () => {
        selected.clear();
        syncUrl();
        apply();
      });
    }

    // 首次应用（支持带 ?tag= 直接进入）
    apply();
  }

  setupNotesFilter();
  setupCodeBlocks();
  document.addEventListener("astro:page-load", () => {
    setupNotesFilter();
    setupCodeBlocks();
  });
</script>

---
/**
 * 注解（Term）组件
 *
 * 与 remark 指令 `:term[术语]{annotation=注解}` 渲染结果完全一致，
 * 供 MDX 按需引入使用：
 *
 *   import Term from "@/components/Term.astro";
 *   <Term annotation="这是注解">术语</Term>
 *
 * 渲染为 <span class="term" data-annotation="...">术语</span>，
 * 复用全局的 .term / .term-tooltip 样式与 term-tooltip 交互脚本。
 */
type Props = {
  /** 注解内容（纯文本） */
  annotation: string;
  /** 可选，附加的 class */
  class?: string;
};

const { annotation, class: className = "" } = Astro.props;
---

<span class:list={["term", className]} data-annotation={annotation}><slot /></span>

---
import type { CollectionEntry } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import { getPostUrl } from "@/utils/getPostPaths";
import { toTransitionName } from "@/utils/toTransitionName";
import { slugifyStr } from "@/utils/slugify";
import config from "@/config";
import Datetime from "./Datetime.astro";

type Props = {
  variant?: "h2" | "h3";
} & CollectionEntry<"posts">;

const { variant: Heading = "h2", id, data, filePath } = Astro.props;

const { title, description, ...props } = data;

const locale = Astro.currentLocale ?? config.site.lang;
const categoryName = data.category;
---

<li class="my-6">
  <a
    href={getPostUrl(id, filePath, locale)}
    class:list={[
      "text-accent inline-block text-lg font-medium",
      "decoration-dashed underline-offset-4 hover:underline",
      "focus-visible:no-underline focus-visible:underline-offset-0",
    ]}
  >
    <Heading transition:name={toTransitionName(title)}>
      {title}
    </Heading>
  </a>

  <div class="flex flex-wrap items-center gap-x-2 gap-y-1">
    <Datetime {...props} />
    {
      categoryName && (
        <a
          href={getRelativeLocaleUrl(
            locale,
            `category/${slugifyStr(categoryName)}/`
          )}
          class="category-badge inline-flex items-center gap-1 text-sm leading-none font-normal text-muted-foreground no-underline transition-colors"
        >
          <span class="opacity-60">#</span>
          {categoryName}
        </a>
      )
    }
  </div>

  <p>{description}</p>
</li>

<style>
  /* 默认低调的纯文本，hover 时文字变主题色（无边框/背景，不撑开日期行） */
  .category-badge {
    cursor: pointer;
  }
  .category-badge:hover {
    color: var(--color-accent);
  }
  .category-badge:hover span {
    opacity: 0.9;
  }
</style>
